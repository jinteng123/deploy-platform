ENV=dev
HTTP_ADDR=:8000
FRONTEND_DIR=../frontend/dist
DATABASE_DSN=deploy:deploy-platform@tcp(127.0.0.1:3306)/deploy_platform?parseTime=true&charset=utf8mb4
MOCK_RUNTIME=true
TRANSFER_DIR=/data/transfer_space

# 镜像仓库（与 Python 后端同名）
REGISTRY_HOST=registry.example.com
REGISTRY_PROJECT=Demo
REGISTRY_USER=admin
REGISTRY_PASSWORD=
# 可选 Bearer token 服务主机白名单（逗号分隔，仅主机名；默认只信任 REGISTRY_HOST）
REGISTRY_AUTH_HOSTS=

# 文件清理（每天凌晨 2:00 Asia/Shanghai 删除超过 N 天的传输文件）
CLEANUP_MAX_AGE_DAYS=3
# 可选后台镜像漂移观测：0 为关闭；启用后范围为 60–86400 秒。
DRIFT_POLL_INTERVAL_SECONDS=0

# 命令超时（秒）
LOCAL_COMMAND_TIMEOUT=600
SSH_COMMAND_TIMEOUT=180

# 镜像事件驱动 CD（云效 Webhook）
# Webhook 共享 token；非 mock 模式留空将拒绝接收（503）
YUNXIAO_WEBHOOK_TOKEN=

# 集群凭据加密密钥（AES-256-GCM），base64 编码的 32 字节
# 生成命令：openssl rand -base64 32
# 存在启用 kubeconfig/token 连接的集群时必须配置，否则服务启动失败
CREDENTIAL_ENCRYPTION_KEY=

# 真实生产环境始终独立审批；false 仅在 mock 运行中允许直接晋级
PROMOTION_APPROVAL=true
# 空数据库真实启动时必须设置；已有用户时忽略。仅 MOCK_RUNTIME 开发模式保留 admin123 回退。
ADMIN_INITIAL_PASSWORD=
# 通知默认关闭；启用后补发未投递的历史终态任务，请选择合适的接收端
# 真环境要求 HTTPS；签名 secret >=32 字节，接收端按稳定 event ID 去重
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# 可选内部 CA bundle（PEM）；追加到系统信任根，不跳过证书校验；文件需挂载到容器
NOTIFICATION_WEBHOOK_CA_FILE=
# 用户可访问的平台根地址；配置后通知 task_url 使用绝对地址，否则使用站内相对路径
PLATFORM_PUBLIC_URL=
