# Never send local credentials into the Docker build context. .gitignore does
# not apply to Docker builds.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Exclude local tooling output and documentation unrelated to the image.
.git
**/.git
**/node_modules
**/dist
**/*.log
docs
infra
charts
references
