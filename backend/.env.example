# ============================================================
# 环境变量配置 — 复制为 .env 后按实际情况修改
# ============================================================

# dev = 公网验证 (Mock Docker/K8s)  |  prod = 院内真实执行
ENV=dev
DEBUG=true

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YourPasswordHere
DB_NAME=deploy_platform

# ---- 镜像仓库 (阿里云 ACR / Harbor) ----
# prod 院内: registry.example.com
# 或 Harbor: 127.0.0.1
REGISTRY_HOST=registry.example.com
REGISTRY_PROJECT=Demo
REGISTRY_USER=admin
REGISTRY_PASSWORD=

# ---- K8s Master SSH (prod: 127.0.0.1) ----
K8S_MASTER_HOST=127.0.0.1
K8S_MASTER_PORT=22
K8S_MASTER_USER=root
# 留空则使用 ssh-agent / 默认密钥
K8S_MASTER_KEY_PATH=

# ---- 文件目录 ----
TRANSFER_DIR=/data/transfer_space

# ---- 文件过期天数 ----
CLEANUP_MAX_AGE_DAYS=3
